# Copy to .env.local. Never use NEXT_PUBLIC_ for these values.
PAYMONGO_SECRET_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYMENT_LINK_SECRET=
SITE_URL=http://localhost:3000
# Enable only the methods activated on your PayMongo merchant account.
PAYMONGO_PAYMENT_METHODS=card,gcash
# A live key is refused until this is explicitly true. Start with sk_test_ keys.
PAYMENTS_LIVE_ENABLED=false

# Booking module. Run npm run booking:setup for local host credentials/secrets.
# Local development uses .booking-data/bookings.db when URL is blank.
# Vercel requires a remote libSQL database and auth token, never a file: URL.
BOOKING_DATABASE_URL=
BOOKING_DATABASE_AUTH_TOKEN=
BOOKING_ADMIN_PASSWORD_HASH=
BOOKING_SESSION_SECRET=
BOOKING_TOKEN_SECRET=
# Optional PayMongo webhook endpoint signing secret (not the API key).
PAYMONGO_WEBHOOK_SECRET=
# Private scheduler token for /api/bookings/maintenance. Never put it in a URL.
CRON_SECRET=
